    {
      "description": "Node-local convergence state, sampled every `:metrics_interval`. `unreconciled_keys` is omitted, not zeroed, above the scan ceiling.",
      "emitter": "AuroraMeter.Cluster",
      "event": "[:aurora_meter, :cluster, :lag]",
      "form": "execute",
      "measurements": [
