    {
      "description": "One buffered increment. `declared` is false when no plan declares the feature.",
      "emitter": "AuroraMeter",
      "event": "[:aurora_meter, :track]",
      "form": "execute",
      "measurements": [
        "count"
      ],
      "metadata": [
        "declared",
        "feature",
        "tenant_key"
      ],
      "names": [
        [
          "aurora_meter",
          "track"
        ]
      ],
      "since": "0.1.0",
      "tags": []
    },
    {
