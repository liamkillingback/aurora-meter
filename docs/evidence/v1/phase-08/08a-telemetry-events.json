        "tenant_key"
      ],
      "names": [
        [
          "aurora_meter",
          "reserve"
        ]
      ],
      "since": "0.2.0",
      "tags": [
        "result"
      ]
    },
    {
      "description": "One committed flush batch. Kept unchanged beside the span below.",
      "emitter": "AuroraMeter.Flusher",
      "event": "[:aurora_meter, :flush]",
      "form": "execute",
      "measurements": [
        "count",
        "delta_sum"
      ],
      "metadata": [],
      "names": [
        [
          "aurora_meter",
          "flush"
        ]
      ],
      "since": "0.1.0",
      "tags": []
    },
    {
      "description": "The database write failed and the same batch is retained for an idempotent retry.",
      "emitter": "AuroraMeter.Flusher",
      "event": "[:aurora_meter, :flush, :error]",
      "form": "execute",
      "measurements": [
        "count"
      ],
      "metadata": [
        "error"
      ],
      "names": [
        [
          "aurora_meter",
          "flush",
          "error"
        ]
      ],
      "since": "0.3.0",
      "tags": []
    },
    {
      "description": "A span around the storage write. `:stop` carries `duration` and `result` (`:ok` or `:error`); `:exception` carries `kind`. `batch_id` is metadata for correlation and never a tag.",
      "emitter": "AuroraMeter.Flusher",
      "event": "[:aurora_meter, :flush]",
      "form": "span",
      "measurements": [
        "count",
        "delta_sum",
        "duration",
        "monotonic_time",
        "system_time"
      ],
      "metadata": [
        "batch_id",
        "counter_rows",
        "history_rows",
        "kind",
        "reason",
        "result",
        "stacktrace"
      ],
      "names": [
        [
          "aurora_meter",
          "flush",
          "start"
        ],
        [
          "aurora_meter",
          "flush",
          "stop"
        ],
        [
          "aurora_meter",
          "flush",
          "exception"
        ]
      ],
      "since": "1.0.0",
      "tags": [
        "result",
        "kind"
      ]
    },
    {
      "description": "One PubSub broadcast tick of touched counters.",
      "emitter": "AuroraMeter.Broadcaster",
