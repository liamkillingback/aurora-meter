[mixlane] core: DB_PORT=5490 mix run -e 
  false = Code.ensure_loaded?(Oban)
  false = Code.ensure_loaded?(AuroraMeter.Oban)

  true = Code.ensure_loaded?(AuroraMeter.Credits.LotMigration)
  true = Code.ensure_loaded?(Mix.Tasks.AuroraMeter.Credits.MigrateLots)

  # The cutover gate is closed and says why, with no database anywhere near it.
  %{finding: "X250"} = AuroraMeter.Credits.LotMigration.cutover_blocked()

  # A tenant key that is not a legal operation name is still nameable.
  "lot_migration:org_42" = AuroraMeter.Credits.LotMigration.checkpoint_name("org_42")
  name = AuroraMeter.Credits.LotMigration.checkpoint_name("ops@example.com")
  true = String.starts_with?(name, "lot_migration:sha256-")

  # And the fold really decides, with no repo, no clock and no optional
  # dependency: a grant of 5 USD and a debit of 2 USD replay into one lot with
  # 3 USD available and 2 USD consumed.
  row = fn attrs ->
    Map.merge(
      %{
        id: Ecto.UUID.generate(),
        tenant_key: "headless",
        kind: :grant,
        category: :paid,
        amount: 0,
        held_delta: 0,
        balance_after: 0,
        held_after: 0,
        promotional_after: nil,
        reference: nil,
        status: nil,
        settled_amount: nil,
        expires_at: nil,
        expired_at: nil,
        metadata: %{},
        seq: 0,
        hold_transaction_id: nil,
        updated_at: nil,
        inserted_at: ~U[2026-01-01 00:00:00.000000Z]
      },
      attrs
    )
    |> then(&struct!(AuroraMeter.Schema.CreditTransaction, &1))
  end

  rows = [
    row.(%{kind: :grant, amount: 5_000_000, balance_after: 5_000_000, reference: "pi_h", seq: 1}),
    row.(%{
      kind: :debit,
      category: nil,
      amount: -2_000_000,
      balance_after: 3_000_000,
      reference: "job_h",
      seq: 2,
      inserted_at: ~U[2026-01-02 00:00:00.000000Z]
    })
  ]

  {:ok, book} = AuroraMeter.Credits.LotMigration.replay(rows, "headless")
  [lot] = book.lots
  "pi_h" = lot.reference
  %{balance: 3_000_000, held: 0, promotional: 0} =
    AuroraMeter.Credits.Allocator.projection(book.book, book.debt)
    |> Map.take([:balance, :held, :promotional])

  # A history it cannot reproduce is refused, here as everywhere.
  bad = [
    row.(%{kind: :grant, amount: 5_000_000, balance_after: 4_000_000, reference: "pi_bad", seq: 1})
  ]

  {:blocked, [%{flag: :ledger_chain_mismatch, blocking: true} | _]} =
    AuroraMeter.Credits.LotMigration.replay(bad, "headless")

  IO.puts("headless ok")

