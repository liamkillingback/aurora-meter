[mixlane] core: DB_PORT=5490 mix run -e 
  false = Code.ensure_loaded?(Oban)
  false = Code.ensure_loaded?(AuroraMeter.Oban)
  false = Code.ensure_loaded?(AuroraMeter.Oban.CreditExpiry)

  # The lot engine is not optional. Everything 06a added has to be here.
  true = Code.ensure_loaded?(AuroraMeter.Credits.Allocator)
  true = Code.ensure_loaded?(AuroraMeter.Credits.ConservationError)
  true = Code.ensure_loaded?(AuroraMeter.Schema.CreditLot)
  true = Code.ensure_loaded?(AuroraMeter.Schema.CreditAllocation)
  true = Code.ensure_loaded?(AuroraMeter.Migration.V9)
  9 = AuroraMeter.Migration.latest_version()
  true = 9 in AuroraMeter.Migration.data_loss_versions()

  # And the planner really decides, with no database and no optional dependency
  # anywhere near it: a 6 USD debit against promotional 3, promotional 5 and
  # paid 10 takes 3 and 3.
  lot = fn id, category, amount, expires_at, seq ->
    %{id: id, category: category, amount: amount, available: amount, reserved: 0,
      consumed: 0, reversed: 0, expired: 0, expires_at: expires_at,
      granted_at: ~U[2026-01-01 00:00:00Z], seq: seq, source: %{}}
  end

  book = [
    lot.("a", :promotional, 3_000_000, ~U[2026-10-01 00:00:00Z], 1),
    lot.("b", :promotional, 5_000_000, ~U[2026-11-01 00:00:00Z], 2),
    lot.("p", :paid, 10_000_000, nil, 3)
  ]

  {:ok, plan} =
    AuroraMeter.Credits.Allocator.plan(
      book,
      {:debit, 6_000_000, ~U[2026-09-15 00:00:00Z], false, 0, 0}
    )

  [3_000_000, 3_000_000] = Enum.map(plan.movements, & &1.amount)
  ["a", "b"] = Enum.map(plan.movements, & &1.lot_id)

  # And the ledger really writes, against the real database, with no Oban in
  # the build.
  {:ok, _} = AuroraMeter.TestRepo.start_link(pool_size: 2)
  {:ok, _} = Phoenix.PubSub.Supervisor.start_link(name: AuroraMeter.TestPubSub)
  tenant = "headless_" <> Integer.to_string(System.unique_integer([:positive]))
  AuroraMeter.Credits.Ledger.enable_lots!(tenant)
  {:ok, _} = AuroraMeter.Credits.grant(tenant, 5_000_000, reference: tenant <> ":pay")
  {:ok, _} = AuroraMeter.Credits.debit(tenant, 2_000_000, tenant <> ":spend")
  %{balance: 3_000_000, available: 3_000_000} = AuroraMeter.Credits.balance(tenant)

  IO.puts("headless ok")

