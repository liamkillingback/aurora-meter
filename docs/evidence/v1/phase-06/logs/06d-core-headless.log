  false = AuroraMeter.Operations.paused?(AuroraMeter.Credits.Recurrences.operation())

  tenant = "headless_06d_#{System.unique_integer([:positive])}"

  {:ok, _} = AuroraMeter.subscribe(tenant, :allowance)
  _ = AuroraMeter.Credits.Ledger.enable_lots!(tenant)

  {:ok, summary} = AuroraMeter.Credits.Recurrences.run(tenant: tenant)
  1 = summary.counts["granted"]
  5_000_000 = summary.counts["amount"]

  {:ok, second} = AuroraMeter.Credits.Recurrences.run(tenant: tenant)
  0 = second.counts["granted"]
  1 = second.counts["duplicate"]

  [lot] = AuroraMeter.Credits.Lots.list(tenant)
  5_000_000 = lot.amount
  "monthly" = lot.source["recurrence"]

  %{recurrences: [row]} = AuroraMeter.Credits.Recurrences.status(tenant: tenant)
  :granted = row.state

  AuroraMeter.TestRepo.query!(
