  "credits_recurrences:global" = AuroraMeter.Credits.Recurrences.operation()

  # The DSL compiles and validates with nothing optional loaded.
  [%{name: :monthly, amount: 5_000_000, rollover: 1_000_000, expires: :period_end}] =
    AuroraMeter.Plans.get(:allowance).recurring_credits

  [] = AuroraMeter.Plans.get(:pro).recurring_credits

  # And the period walk decides with no database and no dependency at all.
  {:ok, [september], :complete} =
    AuroraMeter.Credits.Recurrences.periods("headless_org", nil, ~U[2026-09-16 10:00:00Z], 12)

  ~U[2026-09-01 00:00:00Z] = september.start
  ~U[2026-10-01 00:00:00Z] = september.end

  {:ok, [_july, _august, _september], :complete} =
    AuroraMeter.Credits.Recurrences.periods(
