  false = Code.ensure_loaded?(Oban)
  false = Code.ensure_loaded?(Phoenix.LiveView)
  false = Code.ensure_loaded?(Igniter)

  # The whole 07a surface, present with nothing optional loaded.
  true = function_exported?(AuroraMeter.Plans, :get, 2)
  true = function_exported?(AuroraMeter.Plans, :versions, 1)
  true = function_exported?(AuroraMeter.Plans, :base, 1)
  true = function_exported?(AuroraMeter.Plans, :register!, 0)
  true = function_exported?(AuroraMeter.Storage, :put_plan_version, 1)
  true = function_exported?(AuroraMeter.Storage, :list_plan_versions, 1)
  true = function_exported?(AuroraMeter.Storage, :assign_legacy_plan_versions, 1)
  true = Code.ensure_loaded?(AuroraMeter.Plans.Snapshot)
  true = Code.ensure_loaded?(AuroraMeter.Schema.PlanVersion)
  true = Code.ensure_loaded?(AuroraMeter.Schema.PlanTransition)
  true = Code.ensure_loaded?(AuroraMeter.PlanVersionConflictError)
  10 = AuroraMeter.Migration.latest_version()

  # The fingerprint is a pure function and answers before any process starts.
  plan = %AuroraMeter.Plan{id: :pro, version: "1", price: 2_000, features: %{}}
  32 = byte_size(AuroraMeter.Plans.Snapshot.fingerprint(plan))

  # A real cycle on a real database, booted the way a host boots it.
  {:ok, _} = AuroraMeter.TestRepo.start_link(pool_size: 2)
  {:ok, _} = Phoenix.PubSub.Supervisor.start_link(name: AuroraMeter.TestPubSub)

  AuroraMeter.TestRepo.query!("DELETE FROM aurora_meter_plan_versions", [])
  :ok = AuroraMeter.Plans.reset_registry()

  # The boot step itself, with nothing optional in the build.
  {:ok, _} = AuroraMeter.start_link([])
  :ok = AuroraMeter.Plans.registry_state()

  tenant = "headless_07a_#{System.unique_integer([:positive])}"
  {:ok, _} = AuroraMeter.subscribe(tenant, :versioned)
  "1" = AuroraMeter.plan(tenant).version
  2_000 = AuroraMeter.plan(tenant).price
  1_000 = AuroraMeter.quota(tenant, :ai_generations).limit

  # Deploy: version 2 effective in the past. The tenant stays on version 1.
  Application.put_env(:aurora_meter, :plans, AuroraMeter.Test.VersionTwoLivePlans)
  :ok = AuroraMeter.Subscriptions.invalidate(tenant)
  "2" = AuroraMeter.Plans.get(:versioned).version
  "1" = AuroraMeter.plan(tenant).version
  2_000 = AuroraMeter.plan(tenant).price
  1_000 = AuroraMeter.quota(tenant, :ai_generations).limit

  # Delete version 1 from code entirely: the tenant still reads version 1, and
  # it can only have come from the stored snapshot.
  Application.put_env(:aurora_meter, :plans, AuroraMeter.Test.VersionOneDeletedPlans)
  :ok = AuroraMeter.Subscriptions.invalidate(tenant)
  false = Map.has_key?(AuroraMeter.Test.VersionOneDeletedPlans.__aurora_plans__(), {:versioned, "1"})
  %AuroraMeter.Plan{version: "1", price: 2_000} = AuroraMeter.Plans.get(:versioned, "1")
  "1" = AuroraMeter.plan(tenant).version
  1_000 = AuroraMeter.quota(tenant, :ai_generations).limit

  Application.put_env(:aurora_meter, :plans, AuroraMeter.TestPlans)
  AuroraMeter.TestRepo.query!(
    "DELETE FROM aurora_meter_subscriptions WHERE tenant_key = $1", [tenant])

  IO.puts("headless ok")

