[mixlane] core: DB_PORT=5490 mix run -e 
  false = Code.ensure_loaded?(Oban)
  false = Code.ensure_loaded?(Phoenix.LiveView)
  false = Code.ensure_loaded?(AuroraMeter.Oban.PlanTransitions)

  true = function_exported?(AuroraMeter.Plans, :effective_for, 2)

  {:ok, _} = AuroraMeter.TestRepo.start_link(pool_size: 2)
  {:ok, _} = Phoenix.PubSub.Supervisor.start_link(name: AuroraMeter.TestPubSub)
  {:ok, _} = AuroraMeter.start_link([])

  tenant = "headless_07c_#{System.unique_integer([:positive])}"

  # No subscription at all: unresolved, and an event recorded for it carries no
  # plan and is staged ineligible.
  {:error, :unresolved} = AuroraMeter.Plans.effective_for(tenant, DateTime.utc_now())

  {:ok, _} = AuroraMeter.subscribe(tenant, :pro)
  AuroraMeter.Subscriptions.invalidate(tenant)

  {:ok, {:pro, "1"}} = AuroraMeter.Plans.effective_for(tenant, DateTime.utc_now())

  {:ok, event, :inserted} =
    AuroraMeter.record(tenant, :ai_generations, 3,
      id: "headless-07c-1",
      occurred_at: DateTime.utc_now()
    )

  "pro" = event.plan_id
  "1" = event.plan_version
  :resolved = event.attribution

  # A fact dated before the assignment started, with no transition history:
  # unresolvable, and stored as such rather than as today's plan.
  {:ok, back, :inserted} =
    AuroraMeter.record(tenant, :ai_generations, 1,
      id: "headless-07c-2",
      occurred_at: DateTime.add(DateTime.utc_now(), -86_400, :second)
    )

  nil = back.plan_id
  nil = back.plan_version
  :plan_unresolved = back.attribution

  AuroraMeter.TestRepo.query!(
    "DELETE FROM aurora_meter_events WHERE tenant_key = $1", [tenant])
  AuroraMeter.TestRepo.query!(
    "DELETE FROM aurora_meter_event_totals WHERE tenant_key = $1", [tenant])
  AuroraMeter.TestRepo.query!(
    "DELETE FROM aurora_meter_plan_transitions WHERE tenant_key = $1", [tenant])
  AuroraMeter.TestRepo.query!(
    "DELETE FROM aurora_meter_subscriptions WHERE tenant_key = $1", [tenant])

  IO.puts("headless ok")

