  false = Code.ensure_loaded?(Oban)
  false = Code.ensure_loaded?(Phoenix.LiveView)

  # I20 and criterion 10, both halves. The worker is inside the optional Oban
  # tree and is absent; the operation it wraps is core and is callable.
  false = Code.ensure_loaded?(AuroraMeter.Oban)
  false = Code.ensure_loaded?(AuroraMeter.Oban.PlanTransitions)
  false = function_exported?(AuroraMeter.Oban.PlanTransitions, :perform, 1)

  true = Code.ensure_loaded?(AuroraMeter.Subscriptions)
  true = function_exported?(AuroraMeter.Subscriptions, :apply_due_transitions, 1)
  true = function_exported?(AuroraMeter.Subscriptions, :schedule_transition, 3)
  true = function_exported?(AuroraMeter.Subscriptions, :cancel_transition, 3)
  true = function_exported?(AuroraMeter.Subscriptions, :confirm_transition, 3)
  true = function_exported?(AuroraMeter.Subscriptions, :preview_transition, 3)
  true = Code.ensure_loaded?(AuroraMeter.Schema.PlanTransition)

  # The optional provider callbacks resolve with nothing optional installed, and
  # the core-only answer is "not configured" rather than a crash.
  false = function_exported?(AuroraMeter.Billing.Noop, :describe_plan_change, 3)

  [describe_plan_change: 3, update_subscription_plan: 3] =
    Enum.sort(AuroraMeter.Billing.Provider.behaviour_info(:optional_callbacks))

  # A real transition, scheduled, previewed and applied, on a real database with
  # nothing optional in the build.
  {:ok, _} = AuroraMeter.TestRepo.start_link(pool_size: 2)
  {:ok, _} = Phoenix.PubSub.Supervisor.start_link(name: AuroraMeter.TestPubSub)

  tenant = "headless_07b_#{System.unique_integer([:positive])}"

  {:ok, subscribed} = AuroraMeter.subscribe(tenant, :pro)
  %DateTime{} = subscribed.plan_effective_at

  {:ok, preview} = AuroraMeter.Subscriptions.preview_transition(tenant, :scale)
  %{status: :not_configured, detail: %{}} = preview.provider
  2_000 = preview.from.price
  2_000 = preview.to.price

  {:ok, transition} =
    AuroraMeter.Subscriptions.schedule_transition(tenant, :scale, ref: "headless-1")

  "pending" = transition.state

  {:ok, %{applied: 0, skipped: 1}} =
    AuroraMeter.Subscriptions.apply_due_transitions(tenant: tenant)

  {:ok, %{applied: 1, skipped: 0, failed: 0, cursor: :done}} =
    AuroraMeter.Subscriptions.apply_due_transitions(
      tenant: tenant,
      now: ~U[2030-12-01 00:00:00Z]
    )

  {:ok, %{applied: 0, skipped: 1}} =
    AuroraMeter.Subscriptions.apply_due_transitions(
      tenant: tenant,
      now: ~U[2030-12-01 00:00:00Z]
    )

  applied = AuroraMeter.Storage.get_subscription(tenant)
  "scale" = applied.plan_id
  "applied" = applied.transition_state
  ^applied = %{applied | plan_effective_at: transition.effective_at}

  AuroraMeter.TestRepo.query!(
    "DELETE FROM aurora_meter_plan_transitions WHERE tenant_key = $1", [tenant])
  AuroraMeter.TestRepo.query!(
    "DELETE FROM aurora_meter_subscriptions WHERE tenant_key = $1", [tenant])

  IO.puts("headless ok")

