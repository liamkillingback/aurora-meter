# The Pro profile's configuration, by name.
#
# THIS FILE IS AN EXAMPLE. Every value below is empty and every value below
# must stay empty. Copy it to `.env`, which is git-ignored, put your own
# TEST-MODE values there, and source it into your shell:
#
#     cp .env.example .env
#     $EDITOR .env
#     set -a; . ./.env; set +a
#     AURORA_SAMPLE_PRO=1 PORT=4021 mix phx.server
#
# The application never reads `.env` itself. You source it; the application
# reads the environment. That is one fewer file the application knows how to
# open.
#
# Nothing here is ever committed with a value in it, and
# `test/secret_scan_test.exs` fails the suite if one appears.
#
# ---------------------------------------------------------------------------
# Selecting the profile
# ---------------------------------------------------------------------------

# Must be exactly "1". Anything else, including "true", "yes" and "on", selects
# the core profile, which needs none of the rest of this file.
AURORA_SAMPLE_PRO=

# ---------------------------------------------------------------------------
# Resolving the private package
# ---------------------------------------------------------------------------

# A least-privilege READ key for the private Hex organisation `phxtemplates`.
# The application never reads this. You run, once, on this machine:
#
#     mix hex.organization auth phxtemplates --key "$AURORA_HEX_READ_KEY"
#
# after which `mix deps.get` can resolve `aurora_meter_pro`. Use a key with
# repository read permission only: a publishing key has no business here.
AURORA_HEX_READ_KEY=

# ---------------------------------------------------------------------------
# Stripe, TEST MODE ONLY
# ---------------------------------------------------------------------------
#
# Every one of these is checked at boot and the application refuses to start
# on the wrong shape, naming the variable. The prefixes Stripe uses are
# structural, which is what makes the check worth having: a live key cannot be
# mistaken for a test key by anything, including you at eleven at night.

# Must begin sk_test_. A key beginning sk_live_ aborts the boot.
STRIPE_SECRET_KEY=

# Must begin pk_test_.
STRIPE_PUBLISHABLE_KEY=

# Must begin whsec_. Obtain it from `stripe listen --print-secret`; it is the
# secret that signs the events the CLI forwards, and it is NOT the secret of
# any endpoint registered in your Stripe dashboard. This profile never creates,
# reads or modifies a registered webhook endpoint.
STRIPE_WEBHOOK_SECRET=

# The provider API version this run is pinned to, for example 2025-08-27.basil.
# Required, and deliberately without a default: the evidence a proof run writes
# records which provider contract was tested, and a default would make that
# record a guess.
STRIPE_API_VERSION=

# ---------------------------------------------------------------------------
# The Stripe objects the profile bills against, all in test mode
# ---------------------------------------------------------------------------
#
# Create these once in your test-mode dashboard or with the CLI. The sample
# creates none of them: an application that creates billing objects on boot is
# an application that creates them twice.

# The account this key reaches (acct_...). Aurora Meter Pro puts it in every
# outbox item's identity and confirms it against the account the key actually
# reaches, so an installation cannot stage work for one account and send it
# with another account's key. There is no safe default.
AURORA_STRIPE_ACCOUNT_ID=

# The meter that receives `tokens` meter events (mtr_...). Used to READ a meter
# event summary back.
AURORA_STRIPE_METER_ID=

# The same meter's event NAME, which is what a meter event is SENT under. It is
# a different value from the id above and Pro needs both.
AURORA_STRIPE_METER_EVENT=

# The metered price bound to that meter (price_...).
AURORA_STRIPE_PRICE_TOKENS=

# The recurring price for the `:studio` plan (price_...).
AURORA_STRIPE_PRICE_STUDIO=

# The product credit top-ups are charged against (prod_...).
AURORA_STRIPE_CREDITS_PRODUCT=
